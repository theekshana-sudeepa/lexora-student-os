# ==============================================================================
# LEXORA STUDENT OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' and provide the actual environment values.
# NEVER commit sensitive production credentials or '.env.local' to public Git.
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-url>/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_secure_password@cluster0.mongodb.net/lexora_student_os?retryWrites=true&w=majority

# Administrative Secret Key
# Required to issue programmatic license keys via /api/admin/create-license
# Transmitted via 'x-admin-secret' header
ADMIN_SECRET=your_super_secret_admin_key_here

# Application Base URL (Optional - defaults to localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
